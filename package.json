  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --check src/main.js && node --test tests/*.test.mjs && npm run build",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/ms-playwright node scripts/browser-check.mjs verified",
    "assets:optimize": "gltfpack -i public/models/tesla-roadster-2020.glb -o public/models/tesla-roadster-2020-driving.glb -si 0.16 -se 0.003 -km -noq -v"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "gltfpack": "1.3.0",
    "playwright": "1.64.1",
    "vite": "^7.1.9"
  }
}
